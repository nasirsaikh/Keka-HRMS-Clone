@{Layout=null;ViewData["Title"]="Sign in";}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · PeopleHub</title><link rel="stylesheet" href="/vendor/bootstrap.min.css"/><link rel="stylesheet" href="/vendor/bootstrap-icons.css"/><link rel="stylesheet" href="/css/peoplehub.css"/></head>
<body class="ph-login"><div class="ph-login-visual"><div class="ph-login-brand"><i class="bi bi-hexagon-fill"></i> PeopleHub<span>.</span></div><div><p class="ph-login-eyebrow">HUMAN RESOURCES PLATFORM</p><h1>People operations,<br/>beautifully simple.</h1><p class="ph-login-lead">One place for people, time, payroll, performance and every workplace moment.</p></div><div class="ph-login-trust"><i class="bi bi-shield-check"></i> Secure, organisation-scoped access</div></div>
<div class="ph-login-form-area"><main class="ph-login-card"><div class="ph-mobile-brand"><i class="bi bi-hexagon-fill"></i> PeopleHub.</div><p class="ph-eyebrow">WELCOME BACK</p><h2>Sign in to your workspace</h2><p class="text-secondary mb-4">Your team. Your workday. All together.</p>
@if(!ViewData.ModelState.IsValid){<div role="alert" class="alert alert-danger py-2">Invalid username or password.</div>}
<form action="/auth/login" method="post">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]"/><label for="username" class="form-label">Username</label><div class="ph-login-input"><i class="bi bi-person"></i><input id="username" class="form-control" name="username" autocomplete="username" required autofocus placeholder="Your username"></div><label for="password" class="form-label mt-3">Password</label><div class="ph-login-input"><i class="bi bi-lock"></i><input id="password" type="password" class="form-control" name="password" required autocomplete="current-password" placeholder="Your password"></div><button class="btn btn-primary w-100 mt-4" type="submit">Sign in <i class="bi bi-arrow-right ms-2"></i></button></form><p class="small text-secondary mt-4">To access the fictional demo, enable seeding and set a password in your local environment.</p></main></div></body></html>
