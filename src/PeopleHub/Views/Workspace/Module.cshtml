@model ModuleModel
@{ViewData["Title"]=Model.Module.Title;}
<div class="ph-page-top"><div><p class="ph-eyebrow">@Model.Module.Group.ToUpperInvariant()</p><h1>@Model.Module.Title</h1><p>@Model.Module.Description</p></div><div class="ph-page-actions"><button type="button" class="btn btn-outline-secondary btn-sm" hx-get="/workspace/@Model.Module.Slug/grid" hx-target="#resource-grid"><i class="bi bi-arrow-repeat me-1"></i> Refresh</button>
@if(Model.CanWrite){<button type="button" class="btn btn-primary btn-sm" hx-get="/workspace/@Model.Module.Slug/editor" hx-target="#modal-host"><i class="bi bi-plus-lg me-1"></i> @(Model.Module.Slug=="leave-requests"?"Request leave":Model.Module.Slug=="hr-tickets"?"New ticket":"Add record")</button>}</div></div>
<div class="card ph-card"><div class="ph-records-toolbar"><div><span class="ph-records-icon"><i class="bi bi-@Model.Module.Icon"></i></span><strong>@Model.Results.Count records</strong><small>@Model.Module.Title · @Model.Shell.Company.Name</small></div><div class="ph-records-tools"><form id="search-form" onsubmit="return false;"><div class="ph-search-box"><i class="bi bi-search"></i><input type="search" name="q" value="@Model.Search" placeholder="Search page…" aria-label="Search" hx-get="/workspace/@Model.Module.Slug/grid" hx-trigger="input changed delay:350ms, search" hx-target="#resource-grid" hx-include="this" /></div></form><button class="btn btn-outline-secondary btn-sm" type="button" data-export-table="#records-table"><i class="bi bi-download me-1"></i> Export page</button></div></div>
<div id="resource-grid" hx-get="/workspace/@Model.Module.Slug/grid" hx-trigger="hrms:updated from:body" hx-include="#search-form" hx-swap="innerHTML">@await Html.PartialAsync("_Grid",Model)</div></div>
