@{ViewData["Title"]="Theme studio";var shell=(ShellModel)ViewBag.Shell;var saved=(IEnumerable<ThemePreset>)ViewBag.Themes;}
<div class="ph-page-top"><div><p class="ph-eyebrow">APPEARANCE & PERSONALISATION</p><h1>Theme studio <i class="bi bi-palette2 text-primary"></i></h1><p>Build your AdminLTE theme. Colours, typography and density preview instantly.</p></div><div class="ph-page-actions"><button type="button" class="btn btn-outline-secondary btn-sm" id="theme-reset"><i class="bi bi-arrow-counterclockwise me-1"></i> Reset</button><button type="submit" form="save-theme" class="btn btn-primary btn-sm"><i class="bi bi-cloud-arrow-up me-1"></i> Save theme</button></div></div>
<div class="ph-theme-grid"><section class="card ph-card ph-theme-controls"><div class="ph-theme-tabs"><button type="button" class="active" data-theme-tab="design">Design</button><button type="button" data-theme-tab="saved">Saved</button><button type="button" data-theme-tab="export">Export</button></div>
<div class="ph-theme-tab" data-theme-panel="design"><div class="ph-control-title">START FROM A PRESET</div><div id="theme-presets" class="ph-presets"></div><div class="d-flex gap-2 mt-3 mb-4"><button type="button" id="theme-random" class="btn btn-outline-secondary btn-sm flex-fill"><i class="bi bi-shuffle me-1"></i> Surprise me</button><button type="button" id="theme-generate" class="btn btn-outline-secondary btn-sm flex-fill"><i class="bi bi-magic me-1"></i> Generate from primary</button></div>
<div class="ph-control-title">COLOUR PALETTE</div><div id="theme-colors"></div>
<div class="ph-control-title mt-4">LAYOUT & TYPE</div>
<div id="theme-options"></div><div class="ph-control-title mt-4">PERSONALISATION</div>
<label class="form-label">Font size <output id="theme-font-output"></output></label><input type="range" id="theme-font-size" class="form-range" min="12" max="16" step="1"/>
<label class="form-label mt-2">Corner radius <output id="theme-radius-output"></output></label><input type="range" id="theme-radius" class="form-range" min="0" max="16" step="1"/>
</div><div class="ph-theme-tab d-none" data-theme-panel="saved"><p class="text-secondary small">Workspace themes available to you.</p>
@foreach(var item in saved){<div class="ph-saved-theme"><div><strong>@item.Name</strong><small>@(item.Shared?"Shared with the workspace":"Personal theme")</small></div><button type="button" class="btn btn-outline-secondary btn-sm" data-theme-json="@Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(item.TokensJson))">Apply</button></div>}
@if(!saved.Any()){<p class="ph-empty">No saved themes yet.</p>}
</div><div class="ph-theme-tab d-none" data-theme-panel="export"><label class="form-label">Theme JSON (import/export)</label><textarea class="form-control font-monospace" id="theme-json" rows="15" spellcheck="false"></textarea><div class="d-flex flex-wrap gap-2 mt-3"><button type="button" id="theme-import" class="btn btn-primary btn-sm">Import JSON</button><button type="button" id="theme-copy-json" class="btn btn-outline-secondary btn-sm"><i class="bi bi-clipboard me-1"></i> Copy JSON</button><button type="button" id="theme-copy-css" class="btn btn-outline-secondary btn-sm">Copy CSS</button></div></div>
<form id="save-theme" method="post" action="/themes/save" class="ph-theme-save">@Html.AntiForgeryToken()<label class="form-label" for="theme-name">Theme name</label><input class="form-control" id="theme-name" name="name" value="My custom theme" maxlength="80" required/><input type="hidden" id="theme-hidden-tokens" name="tokens" value="{}"/><label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="shared" value="true" @(shell.Role is not ("Admin" or "HR")?"disabled":"")/><span class="form-check-label">Share with workspace</span></label></form>
</section>
<section class="card ph-card ph-theme-preview"><div class="card-header ph-card-header"><div><h2>Live preview</h2><p>The selected design tokens apply directly to the application</p></div><span class="ph-soft-tag"><i class="bi bi-circle-fill me-1"></i> Live</span></div><div class="card-body"><div class="ph-preview"><div class="ph-preview-sidebar"><strong>⬡ PeopleHub</strong><span>▦ &nbsp; Overview</span><span>♧ &nbsp; People directory</span><span>▤ &nbsp; Attendance</span><span>▧ &nbsp; Leave requests</span><span>⚙ &nbsp; Settings</span></div><div class="ph-preview-main"><div class="ph-preview-topbar">Overview <span>◉ &nbsp; Demo HR</span></div><h3>People dashboard</h3><p>Welcome to your workspace</p><div class="ph-preview-stats"><div><strong>12</strong><small>Employees</small></div><div><strong>9</strong><small>Present</small></div><div><strong>3</strong><small>Pending</small></div></div><div class="ph-preview-panel"><b>Recent requests</b><div><span>Aisha Rahman</span><span>Approved</span></div><div><span>Omar Hassan</span><span>Pending</span></div><div><span>Maya Thomas</span><span>Approved</span></div></div><button class="btn btn-primary btn-sm mt-3" type="button">Primary action</button></div></div></div><div class="ph-preview-caption"><i class="bi bi-check-circle me-1"></i> Changes are stored on this browser immediately. Save to share or reuse them.</div></section></div>
@section Scripts {<script src="/js/theme-studio.js" asp-append-version="true"></script>}
